;; deps.edn: the fleet dashboard tools, plain Clojure run by jolt as
;; `jolt <task>`. The git shas below are the heads of main, measured
;; 2026-11-20 with git ls-remote. babashka.process, babashka.fs,
;; cheshire.core and clojure.test come bundled with jolt.
{:paths ["src" "test" "resources"]
 :deps  {io.github.jolt-lang/http-client {:git/url "https://github.com/jolt-lang/http-client.git"
                                          :git/sha "03267126e0bebe172936e9618b9ff6cd678edaac"}
         io.github.jolt-lang/yaml        {:git/url "https://github.com/jolt-lang/yaml.git"
                                          :git/sha "ecbeb028bd319cbcccce6de83eca8eae5fedc7f4"}
         io.github.jolt-lang/time        {:git/url "https://github.com/jolt-lang/time.git"
                                          :git/sha "6c12a58d08586ca60421099d2d3d0bcd473238ac"}}

 :tasks {test {:doc "Run every fleet.*-test namespace; exit 1 on any failure or error"
               :requires ([clojure.test :as t]
                          [fleet.canary-test]
                          [fleet.cli-test]
                          [fleet.collect-test]
                          [fleet.fanout-test]
                          [fleet.github-test]
                          [fleet.publish-test]
                          [fleet.refresh-test]
                          [fleet.status-test]
                          [fleet.version-test])
               :task (let [{:keys [fail error]} (t/run-tests 'fleet.canary-test
                                                             'fleet.cli-test
                                                             'fleet.collect-test
                                                             'fleet.fanout-test
                                                             'fleet.github-test
                                                             'fleet.publish-test
                                                             'fleet.refresh-test
                                                             'fleet.status-test
                                                             'fleet.version-test)]
                       (when (pos? (+ fail error)) (System/exit 1)))}

         fleet:plan {:doc "Canary plan job: decide what to test (env: REQUESTED EVENT INTERVAL_HOURS NIGHTLY_MAX_AGE_HOURS GITHUB_REPOSITORY GH_TOKEN GITHUB_OUTPUT); --final combines the gates (env: INTERVAL_OK ALREADY_GREEN REASON KEY)"
                     :requires ([fleet.cli :as cli])
                     :task (System/exit (cli/plan-main *command-line-args*))}

         fleet:report {:doc "Canary report job: open, update or close the canary issue from results/*/results.json [dir] (env: RESULT VERSIONS NIGHTLY RUN_URL GITHUB_REPOSITORY GITHUB_RUN_ID GH_TOKEN)"
                       :requires ([fleet.cli :as cli])
                       :task (System/exit (cli/report-main *command-line-args*))}

         fleet:fanout {:doc "Dispatch every fleet project against a jolt version and wait: [version] (blank = latest release; env: GH_TOKEN, FLEET_JSON)"
                       :requires ([fleet.cli :as cli])
                       :task (System/exit (cli/fanout-main *command-line-args*))}

         fleet:own-pin {:doc "Print each fleet project's latest push run and pin as JSON (env: GH_TOKEN, FLEET_JSON)"
                        :requires ([fleet.cli :as cli])
                        :task (System/exit (cli/own-pin-main *command-line-args*))}

         fleet:uncovered {:doc "Print the org repos the fleet does not cover, with reasons, as JSON"
                          :requires ([fleet.cli :as cli])
                          :task (System/exit (cli/uncovered-main *command-line-args*))}

         fleet:status {:doc "Merge results into status.json and history.json: --prev-status F --prev-history F --own-pin F --uncovered F --latest V --nightly-json J|null --canary-run URL --now ISO --out-dir D [results.json ...]"
                       :requires ([fleet.cli :as cli])
                       :task (System/exit (cli/status-main *command-line-args*))}

         fleet:refresh {:doc "Collect, merge and write <out-dir>/status.json and history.json [results.json ...] (env: LATEST NIGHTLY_JSON CANARY_RUN, PREV_DIR)"
                        :requires ([fleet.cli :as cli])
                        :task (System/exit (cli/refresh-main *command-line-args*))}

         fleet:publish {:doc "Refresh and commit to origin's status branch: <out-dir> [results.json ...] (env: LATEST NIGHTLY_JSON CANARY_RUN)"
                        :requires ([fleet.cli :as cli])
                        :task (System/exit (cli/publish-main *command-line-args*))}}}
